{
  "name": "unplugin-arborium",
  "version": "0.1.0",
  "type": "module",
  "description": "Build-time WASM asset resolution for arborium syntax highlighting",
  "license": "MIT OR Apache-2.0",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./webpack": {
      "import": "./dist/webpack.js",
      "types": "./dist/webpack.d.ts"
    },
    "./rollup": {
      "import": "./dist/rollup.js",
      "types": "./dist/rollup.d.ts"
    },
    "./esbuild": {
      "import": "./dist/esbuild.js",
      "types": "./dist/esbuild.d.ts"
    },
    "./rspack": {
      "import": "./dist/rspack.js",
      "types": "./dist/rspack.d.ts"
    },
    "./next": {
      "import": "./dist/next.js",
      "types": "./dist/next.d.ts"
    },
    "./runtime-core": {
      "import": "./dist/runtime/index.js",
      "types": "./dist/runtime/index.d.ts"
    },
    "./types": {
      "import": "./dist/runtime/types.js",
      "types": "./dist/runtime/types.d.ts"
    },
    "./resolvers": {
      "import": "./dist/core/resolvers.js",
      "types": "./dist/core/resolvers.d.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@arborium/arborium": "^2.16.0",
    "unplugin": "^2.3.0"
  },
  "devDependencies": {
    "@rslib/core": "^0.10.0",
    "@types/node": "^25.5.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0"
  }
}
