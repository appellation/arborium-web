{
  "name": "unplugin-arborium",
  "version": "0.2.6",
  "type": "module",
  "description": "Build-time WASM asset resolution for arborium syntax highlighting",
  "license": "MIT OR Apache-2.0",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./webpack": {
      "import": "./dist/webpack.js",
      "types": "./dist/webpack.d.ts"
    },
    "./rollup": {
      "import": "./dist/rollup.js",
      "types": "./dist/rollup.d.ts"
    },
    "./esbuild": {
      "import": "./dist/esbuild.js",
      "types": "./dist/esbuild.d.ts"
    },
    "./rspack": {
      "import": "./dist/rspack.js",
      "types": "./dist/rspack.d.ts"
    },
    "./rolldown": {
      "import": "./dist/rolldown.js",
      "types": "./dist/rolldown.d.ts"
    },
    "./farm": {
      "import": "./dist/farm.js",
      "types": "./dist/farm.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./resolvers": {
      "import": "./dist/core/resolvers.js",
      "types": "./dist/core/resolvers.d.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rstest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@arborium/arborium": "^2.16.0",
    "tar-stream": "^3.1.8",
    "unplugin": "^2.3.0"
  },
  "devDependencies": {
    "@arborium/json": "^2.16.0",
    "@rslib/core": "^0.10.0",
    "@rspack/core": "^1.7.9",
    "@rstest/core": "^0.9.4",
    "@types/node": "^25.5.0",
    "@types/tar-stream": "^3.1.4",
    "esbuild": "^0.27.4",
    "prettier": "^3.8.1",
    "rollup": "^4.59.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.1",
    "webpack": "^5.105.4"
  }
}
